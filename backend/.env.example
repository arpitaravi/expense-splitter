# Production env vars (Render). Local dev needs none of these.
DEBUG=0
SECRET_KEY=<long random string>
DATABASE_URL=postgres://...
ALLOWED_HOSTS=your-api.onrender.com
CORS_ORIGINS=https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,https://your-api.onrender.com
FRONTEND_URL=https://your-app.vercel.app
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>   # receipts
# Real emails. Render FREE blocks SMTP ports, so use the Brevo HTTPS API there:
BREVO_API_KEY=xkeysib-...
DEFAULT_FROM_EMAIL=you@gmail.com          # must be a sender verified in Brevo
# Local / paid hosts can use plain SMTP instead (e.g. Gmail app password):
# EMAIL_HOST_USER=you@gmail.com  EMAIL_HOST_PASSWORD=<app password>
# Daily scheduler hook (recurring expenses + Monday digest); called by .github/workflows/daily-cron.yml
CRON_TOKEN=<long random string>
# Only if you run a Celery worker + Redis:
# CELERY_ENABLED=1
# REDIS_URL=redis://...
